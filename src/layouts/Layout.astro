---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}
const {
  title = `${site.name} — ${site.role}`,
  description = "Sports photography, portraits & custom graphics by Jacob Combs.",
  hideFooter = false,
} = Astro.props;
const siteUrl = "https://jcwrks.com";
const canonical = new URL(Astro.url.pathname, siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (link previews in texts / iMessage / social) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Jacob Combs Photography" />

    <!-- Twitter / X large image card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />
  </head>
  <body class="grain font-body antialiased selection:bg-accent selection:text-white">
    <span id="top"></span>
    <!-- #6: scroll progress / exposure meter -->
    <div class="scroll-meter" data-scroll-meter></div>
    <!-- #2: camera shutter flash overlays (fire on hero click) -->
    <div class="shutter" data-shutter></div>
    <div class="shutter-frame" data-shutter-frame aria-hidden="true">
      <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 100 100">
        <path d="M6 6 H20 M6 6 V20 M94 6 H80 M94 6 V20 M6 94 H20 M6 94 V80 M94 94 H80 M94 94 V80"
          fill="none" stroke="#ffffff" stroke-width="0.5" vector-effect="non-scaling-stroke" opacity="0.9" />
      </svg>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <script>
      // buttery smooth scroll (skips when user prefers reduced motion)
      import Lenis from "lenis";
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduceMotion) {
        const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href") || "";
            e.preventDefault();
            if (id === "#top" || id === "#") lenis.scrollTo(0);
            else lenis.scrollTo(id);
          });
        });
      }
    </script>

    <script>
      // ---- #6: scroll progress / exposure meter ----
      const meter = document.querySelector("[data-scroll-meter]") as HTMLElement | null;
      if (meter) {
        let ticking = false;
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          const p = h > 0 ? Math.min(window.scrollY / h, 1) : 0;
          meter.style.setProperty("--p", p.toFixed(4));
          ticking = false;
        };
        window.addEventListener("scroll", () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }

      // ---- signature writes itself (hero: after load; others: on scroll-in) ----
      const signs = Array.from(document.querySelectorAll("[data-sign]")) as HTMLElement[];
      const reduceSign = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      signs.forEach((sig) => {
        if (reduceSign) { sig.classList.remove("sign-write"); return; }
        const inHero = !!sig.closest("[data-hero]");
        if (inHero) {
          // play once the hero text has risen in
          setTimeout(() => sig.classList.add("writing"), 800);
        } else if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) { (e.target as HTMLElement).classList.add("writing"); io.unobserve(e.target); }
            });
          }, { threshold: 0.6 });
          io.observe(sig);
        } else {
          sig.classList.add("writing");
        }
      });

      // ---- #2: camera shutter flash when clicking the hero ----
      const shutter = document.querySelector("[data-shutter]") as HTMLElement | null;
      const frame = document.querySelector("[data-shutter-frame]") as HTMLElement | null;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hero = document.querySelector("[data-hero]");
      if (hero && shutter && frame && !reduce) {
        hero.addEventListener("click", (e) => {
          // don't fire when clicking the buttons/links in the hero
          if ((e.target as HTMLElement).closest("a,button")) return;
          shutter.classList.remove("fire"); frame.classList.remove("fire");
          void shutter.offsetWidth; // restart animation
          shutter.classList.add("fire"); frame.classList.add("fire");
        });
      }
    </script>

    <script>
      // reveal sections as they scroll into view
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-in"));
      }
    </script>
  </body>
</html>
