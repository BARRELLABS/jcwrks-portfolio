---
import { categories } from "../data/categories";
import Placeholder from "./Placeholder.astro";
import { getCover } from "../lib/galleries";

interface Props {
  heading?: string;
  showIntro?: boolean;
}
const { heading = "The work", showIntro = true } = Astro.props;
const tiles = categories.map((cat) => ({ ...cat, resolvedCover: getCover(cat.slug, cat.cover) }));
---
<section class="mx-auto max-w-[1400px] px-6 sm:px-10 pt-8 sm:pt-10 pb-16 sm:pb-24">
  {showIntro && (
    <div data-reveal class="mb-8 sm:mb-12 max-w-2xl">
      <p class="text-fog tracking-[0.25em] uppercase text-[11px] mb-4 flex items-center gap-3">
        <span class="h-px w-7 bg-accent inline-block"></span> Categories
      </p>
      <h2 class="font-display font-medium text-3xl sm:text-5xl tracking-[-0.02em]">{heading}</h2>
    </div>
  )}

  <!-- uniform grid: every tile the same size, image fills via object-cover -->
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
    {tiles.map((cat, i) => (
      <a
        href={`/work/${cat.slug}`}
        data-reveal
        class="group relative block aspect-[4/5] overflow-hidden rounded-2xl border border-line hover:border-accent/40 transition-colors duration-500"
        style={`animation-delay:${i * 60}ms`}
      >
        {cat.resolvedCover ? (
          <img src={cat.resolvedCover} alt={cat.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-105" />
        ) : (
          <Placeholder label={cat.title} seed={i + 1} class="absolute inset-0 h-full w-full transition-transform duration-[1100ms] ease-out group-hover:scale-105" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
        <span class="absolute top-4 left-5 sm:top-6 sm:left-7 text-white/60 text-xs tabular-nums group-hover:text-accent-bright transition-colors duration-300">{String(i + 1).padStart(2, "0")}</span>
        <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 flex flex-col text-white">
          <h3 class="font-display font-medium text-xl sm:text-3xl tracking-[-0.01em]">{cat.title}</h3>
          <p class="text-white/70 text-xs sm:text-sm mt-1 sm:mt-1.5 max-w-xs line-clamp-2">{cat.blurb}</p>
          <span class="mt-3 sm:mt-4 inline-flex items-center gap-2 text-[12px] sm:text-[13px] text-white/85">
            <span>{cat.type === "group" ? "Browse sports" : "View gallery"}</span>
            <span class="text-accent-bright transition-transform duration-300 group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
