---
import { site } from "../data/site";
const links = [
  { href: "/photo-video", label: "Photo & Video" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
---
<header
  data-nav
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300 border-b border-transparent"
>
  <nav class="mx-auto max-w-[1400px] px-5 sm:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- logo + wordmark -->
    <a href="/" class="logo-link flex items-center gap-2.5 group">
      <span class="logo-draw h-10 w-10 shrink-0">
        <svg class="draw-svg" viewBox="0 0 100 100" aria-hidden="true">
          <!-- one continuous star stroke (draw-a-star-without-lifting-the-pen) -->
          <path class="star-path" pathLength="100"
            d="M50 8 L61.8 79.8 L7 34.6 L93 34.6 L38.2 79.8 Z" />
          <!-- completion burst ring -->
          <circle class="burst" cx="50" cy="50" r="24" />
          <!-- spark particles flicking outward on completion -->
          <circle class="particle p1" cx="50" cy="50" r="2.4" style="--px:26px;--py:-20px" />
          <circle class="particle p2" cx="50" cy="50" r="2" style="--px:-24px;--py:-14px" />
          <circle class="particle p3" cx="50" cy="50" r="2.6" style="--px:18px;--py:24px" />
          <circle class="particle p2" cx="50" cy="50" r="1.8" style="--px:-20px;--py:22px" />
          <circle class="particle p3" cx="50" cy="50" r="2.2" style="--px:32px;--py:6px" />
          <!-- bright comet head riding the end of the stroke -->
          <circle class="spark" r="3.6">
            <animateMotion dur="1.1s" begin="0s" fill="freeze" keyPoints="0;1" keyTimes="0;1" calcMode="linear"
              path="M50 8 L61.8 79.8 L7 34.6 L93 34.6 L38.2 79.8 Z" />
          </circle>
          <!-- twinkling 4-point sparkles (pop after settle + on hover) -->
          <path class="twinkle tw1" fill="#fff" d="M74 24 q-3 6 -8 8 q5 2 8 8 q3 -6 8 -8 q-5 -2 -8 -8 z" />
          <path class="twinkle tw2" fill="var(--color-accent-bright)" d="M24 60 q-2.2 4.4 -6 6 q3.8 1.6 6 6 q2.2 -4.4 6 -6 q-3.8 -1.6 -6 -6 z" />
        </svg>
        <img src="/logo.png" alt="jc_wrks logo" class="logo-real block h-10 w-auto" />
      </span>
      <span class="font-display font-medium tracking-tight text-xl text-bone group-hover:text-accent transition-colors">
        {site.brand}
      </span>
    </a>

    <!-- desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "text-sm font-medium tracking-wide transition-colors hover:text-bone inline-flex items-center",
            path.startsWith(l.href) ? "text-bone" : "text-fog",
          ]}
        >
          {l.label}
          {path.startsWith(l.href) && <span class="ml-1.5 w-1 h-1 rounded-full bg-accent"></span>}
        </a>
      ))}
      <a href="/contact" class="btn btn-solid text-sm px-5 py-2">Book</a>
    </div>

    <!-- mobile toggle -->
    <button data-menu-btn class="md:hidden text-bone p-2 -mr-2" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </nav>

  <!-- mobile menu -->
  <div data-menu class="hidden md:hidden border-t border-line bg-ink/95 backdrop-blur">
    <div class="px-5 py-4 flex flex-col gap-1">
      {links.map((l) => (
        <a href={l.href} class="py-2.5 text-base text-fog hover:text-bone">{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-solid mt-2 py-2.5 font-medium">Book</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector("[data-nav]");
  const onScroll = () => {
    if (window.scrollY > 24) {
      nav?.classList.add("bg-ink/80", "backdrop-blur-md", "!border-line");
    } else {
      nav?.classList.remove("bg-ink/80", "backdrop-blur-md", "!border-line");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const btn = document.querySelector("[data-menu-btn]");
  const menu = document.querySelector("[data-menu]");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
