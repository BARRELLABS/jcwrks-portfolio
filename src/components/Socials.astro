---
import { site } from "../data/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// only show socials with a real link
const list = Object.entries(site.socials).filter(([, s]) => s.url && s.url !== "#");

// brand glyph paths (single-color, currentColor)
const icons: Record<string, string> = {
