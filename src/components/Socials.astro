---
<div class={`flex items-center gap-2 ${className}`}>
  {list.map(([key, s]) => (
    <a
      href={s.url}
      target="_blank"
      rel="noopener"
      aria-label={s.label}
      title={s.label}
      class="group grid place-items-center w-10 h-10 rounded-full border border-line text-fog hover:text-white hover:border-accent transition-colors duration-300 relative overflow-hidden"
    >
      <span class="absolute inset-0 bg-accent scale-0 group-hover:scale-100 rounded-full transition-transform duration-300 ease-out"></span>
      <svg viewBox="0 0 24 24" fill="currentColor" class="relative w-[18px] h-[18px]">
        <path d={icons[key]} />
      </svg>
    </a>
  ))}
</div>
