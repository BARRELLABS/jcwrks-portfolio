---
---
<section data-hero class="relative min-h-[100svh] flex items-end overflow-hidden">
  <!-- restrained purple light behind the subject (on-brand, not loud) -->
  <div
    class="pointer-events-none absolute left-1/2 top-[48%] -translate-x-1/2 -translate-y-1/2 w-[75vw] max-w-2xl aspect-square rounded-full blur-[120px] opacity-[0.16]"
    style="background: radial-gradient(circle, #8b5cf6 0%, transparent 68%);"
  >
  </div>

  <!-- Jacob — cutout, anchored to the bottom, dissolving into a soft blur -->
  <div class="hero-load absolute inset-0 flex items-end justify-center">
    <div data-hero-scroll class="relative will-change-transform flex items-end justify-center">
      <!-- blurred echo so the bottom edge melts instead of cutting hard -->
      <img src="/jacob-hero.png" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-auto mx-auto blur-2xl opacity-60 hero-mask-bottom" />
      <!-- sharp subject, bottom faded -->
      <img src="/jacob-hero.png" alt="Jacob Combs, sports photographer" class="relative h-[90svh] max-h-[920px] w-auto object-contain hero-mask-fade" />
    </div>
  </div>

  <!-- soft gradient so headline text stays legible over the photo -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent"></div>

  <!-- foreground content -->
  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 pb-12 sm:pb-16">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10">
        <div data-reveal>
          <p class="text-fog tracking-[0.3em] uppercase text-[11px] mb-5 flex items-center gap-3">
            <span class="h-px w-7 bg-accent inline-block"></span> Sports Photographer
          </p>
          <h1 class="font-name font-extrabold leading-[0.88] tracking-[-0.03em] text-6xl sm:text-7xl lg:text-[7.5rem]">
            Jacob Combs
          </h1>
          <img src="/jacob-signature.png" alt="Jacob Combs signature" class="mt-3 h-20 sm:h-24 lg:h-32 w-auto" />
        </div>

        <div data-reveal style="animation-delay:150ms" class="max-w-xs lg:text-right lg:pb-3">
          <p class="text-fog leading-relaxed mb-7 text-[15px]">
            A collection of creativity, passion &amp; perspective — a look at the shots I love most.
          </p>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a href="/photo-video" class="px-6 py-2.5 rounded-full bg-bone text-ink text-sm font-medium hover:bg-accent transition-colors">
              View work
            </a>
            <a href="/contact" class="px-6 py-2.5 rounded-full border border-fog/40 text-sm font-medium hover:border-bone transition-colors">
              Book
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-bone/30 z-10">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9" /></svg>
  </div>
</section>

<script>
  // the only hero motion: gentle zoom-in as you scroll past it
  const hero = document.querySelector("[data-hero]") as HTMLElement | null;
  const fig = document.querySelector("[data-hero-scroll]") as HTMLElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (hero && fig && !reduce) {
    let ticking = false;
    const update = () => {
      const h = hero.offsetHeight || window.innerHeight;
      const p = Math.min(Math.max(window.scrollY / h, 0), 1);
      fig.style.transform = `scale(${(1 + p * 0.2).toFixed(4)})`;
      ticking = false;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
