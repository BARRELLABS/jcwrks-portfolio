---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found — Jacob Combs">
  <section class="mx-auto max-w-[1100px] px-6 sm:px-10 min-h-[80svh] flex flex-col justify-center">
    <p class="text-accent font-medium tracking-[0.28em] uppercase text-[11px] mb-5 flex items-center gap-3">
      <span class="h-px w-7 bg-accent inline-block"></span> 404
    </p>
    <h1 class="font-display font-medium text-5xl sm:text-7xl tracking-[-0.02em] leading-[0.95]">
      <span class="text-fog">This shot</span> missed.
    </h1>
    <p class="text-fog text-lg mt-5 max-w-md">
      That page doesn't exist — but the good stuff still does. Let's get you back to the work.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="btn btn-solid px-6 py-2.5 text-sm">Back home</a>
      <a href="/photo-video" class="btn btn-outline px-6 py-2.5 text-sm">See the work</a>
    </div>
  </section>
</Layout>
