---
import Layout from "../layouts/Layout.astro";
import CategoryTiles from "../components/CategoryTiles.astro";
---
<Layout title="Photo & Video — Jacob Combs">
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10 pt-28 sm:pt-32 pb-2">
    <div data-reveal>
      <p class="text-fog tracking-[0.25em] uppercase text-[11px] mb-4 flex items-center gap-3">
        <span class="h-px w-7 bg-accent inline-block"></span> Photo &amp; Video
      </p>
      <h1 class="font-display font-medium text-5xl sm:text-6xl tracking-[-0.02em]">The work</h1>
      <p class="text-fog mt-5 max-w-xl">Pick a category to dive in — every gallery is a real moment, frozen.</p>
    </div>
  </section>
  <CategoryTiles showIntro={false} />
</Layout>
