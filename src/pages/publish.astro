---
// Jacob's "put my changes live" page.
//
// His CMS edits commit to the `staging` branch, which Netlify never builds —
// that's what stopped every single photo upload costing a paid deploy. This
// page is the friendly front door to the one action that does cost one:
// the Publish workflow, which merges staging into main.
//
// It deliberately just LINKS to the GitHub Actions run page rather than
// triggering the workflow itself. Doing it in-page would mean holding a GitHub
// token in a public static site — not something to put on a public repo.
import Layout from "../layouts/Layout.astro";

const WORKFLOW_URL =
  "https://github.com/BARRELLABS/jcwrks-portfolio/actions/workflows/publish.yml";

const steps = [
  {
    n: "1",
    title: "Hit the purple button",
    body: "It opens GitHub in a new tab. Sign in with your GitHub account if it asks.",
  },
  {
    n: "2",
    title: 'Click "Run workflow"',
    body: 'Grey dropdown on the right. Then click the green "Run workflow" button inside it.',
  },
  {
    n: "3",
    title: "That's it — go make a coffee",
    body: "The site rebuilds on its own. Your new photos are live in about two minutes.",
  },
];
---

<Layout
  title="Publish your changes — jc_wrks"
  description="Put your latest photo uploads live on jcwrks.com."
  noindex={true}
  hideFooter={true}
>
  <section class="mx-auto max-w-[1100px] px-6 sm:px-10 pt-14 sm:pt-20 pb-24">
    <p
      class="text-accent font-medium tracking-[0.28em] uppercase text-[11px] mb-5 flex items-center gap-3"
    >
      <span class="h-px w-7 bg-accent inline-block"></span> Publish
    </p>

    <h1
      class="font-display font-medium text-4xl sm:text-6xl tracking-[-0.02em] leading-[0.98] max-w-3xl"
    >
      <span class="text-fog">Done adding photos?</span> Put them live.
    </h1>

    <p class="text-fog text-lg mt-6 max-w-xl leading-relaxed">
      Everything you've uploaded is saved and waiting. It just isn't on the
      public site yet — one click sends the whole batch out together.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={WORKFLOW_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn px-8 py-4 text-base font-medium rounded-full text-white shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/35 transition-shadow"
        style="background: linear-gradient(90deg, var(--color-accent), var(--color-accent-bright));"
      >
        Publish my changes
        <svg
          class="inline-block ml-2 -mt-px"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17L17 7M17 7H8M17 7v9"></path>
        </svg>
      </a>

      <a href="/admin" class="btn btn-outline px-6 py-3 text-sm rounded-full">
        Back to photos
      </a>
    </div>

    <!-- What happens when you click -->
    <div class="mt-16 grid gap-4 sm:grid-cols-3">
      {
        steps.map((s) => (
          <div class="rounded-2xl bg-charcoal border border-line p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent/10 text-accent font-display font-medium text-sm">
              {s.n}
            </span>
            <h2 class="font-display font-medium text-lg mt-4 tracking-[-0.01em]">
              {s.title}
            </h2>
            <p class="text-fog text-sm mt-2 leading-relaxed">{s.body}</p>
          </div>
        ))
      }
    </div>

    <!-- The one rule that actually matters -->
    <div
      class="mt-10 rounded-2xl border border-accent/25 bg-accent/[0.04] p-6 sm:p-7 max-w-3xl"
    >
      <h2 class="font-display font-medium text-lg tracking-[-0.01em]">
        Publish once, when you're finished
      </h2>
      <p class="text-fog text-sm mt-2 leading-relaxed">
        It costs the same whether you're publishing three photos or three
        hundred, so there's no reason to do it after every upload — just hit it
        once when you're done for the day. Upload as much as you like in the
        meantime; nothing is lost, it's all sat there waiting for you.
      </p>
    </div>

    <!-- Reassurance, because "I uploaded it and can't see it" is the scary bit -->
    <div class="mt-12 max-w-3xl">
      <h2 class="font-display font-medium text-xl tracking-[-0.01em]">
        Good to know
      </h2>
      <dl class="mt-5 divide-y divide-line border-t border-line">
        <div class="py-4 sm:flex sm:gap-8">
          <dt class="font-medium text-sm sm:w-64 shrink-0">
            My photos aren't on the site yet
          </dt>
          <dd class="text-fog text-sm mt-1 sm:mt-0 leading-relaxed">
            That's normal now — they stay tucked away until you publish. Nothing
            is broken and nothing is lost.
          </dd>
        </div>
        <div class="py-4 sm:flex sm:gap-8">
          <dt class="font-medium text-sm sm:w-64 shrink-0">
            Can I check they uploaded?
          </dt>
          <dd class="text-fog text-sm mt-1 sm:mt-0 leading-relaxed">
            Yes — open <a href="/admin" class="text-accent hover:underline"
              >the photo manager</a
            > and you'll see every photo in its gallery.
          </dd>
        </div>
        <div class="py-4 sm:flex sm:gap-8">
          <dt class="font-medium text-sm sm:w-64 shrink-0">
            I clicked it and nothing changed
          </dt>
          <dd class="text-fog text-sm mt-1 sm:mt-0 leading-relaxed">
            Give it two or three minutes, then refresh with
            <span class="text-bone">Ctrl</span> + <span class="text-bone"
              >Shift</span
            > + <span class="text-bone">R</span> to clear the old version out of your
            browser.
          </dd>
        </div>
        <div class="py-4 sm:flex sm:gap-8">
          <dt class="font-medium text-sm sm:w-64 shrink-0">
            What if there's nothing to publish?
          </dt>
          <dd class="text-fog text-sm mt-1 sm:mt-0 leading-relaxed">
            It'll tell you everything's already live and stop. You can't break
            anything by clicking it twice.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
