---
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import Placeholder from "../../components/Placeholder.astro";
import { categories, getCategory } from "../../data/categories";
import { getGalleryImages, getCover } from "../../lib/galleries";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);
if (!cat) return Astro.redirect("/photo-video");
const images = cat.type === "gallery" ? getGalleryImages(cat.slug) : [];
---
<Layout title={`${cat.title} — Jacob Combs`}>
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10 pt-28 sm:pt-32 pb-16">
    <a href="/photo-video" class="text-fog hover:text-bone text-sm">← All categories</a>
    <div data-reveal class="mt-6 mb-8 sm:mb-14">
      <h1 class="font-display font-medium text-4xl sm:text-6xl tracking-[-0.02em]">{cat.title}</h1>
      <p class="text-fog mt-3 sm:mt-4 max-w-xl">{cat.blurb}</p>
    </div>

    {cat.type === "group" ? (
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {cat.sub!.map((s, i) => (
          <a
            href={`/work/${cat.slug}/${s.slug}`}
            data-reveal
            class="group relative block aspect-[4/5] overflow-hidden rounded-2xl border border-line hover:border-accent/40 transition-colors duration-500"
            style={`animation-delay:${i * 60}ms`}
          >
            {getCover(s.slug, s.cover) ? (
              <img src={getCover(s.slug, s.cover)} alt={s.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] group-hover:scale-105" />
            ) : (
              <Placeholder label={s.title} seed={i + 3} class="absolute inset-0 h-full w-full transition-transform duration-[1100ms] group-hover:scale-105" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 flex flex-col text-white">
              <h3 class="font-display font-medium text-lg sm:text-2xl tracking-[-0.01em]">{s.title}</h3>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <Gallery label={cat.title} images={images} count={cat.count!} />
    )}
  </section>
</Layout>
